$TITLE TIMES-NZ generated case: __CASE_NAME__

OPTION PROFILE=1, SOLVEOPT=REPLACE;
OPTION RESLIM=__RESLIM__, ITERLIM=999999, LIMROW=0, LIMCOL=0, SOLPRINT=OFF;
OPTION LP=__SOLVER__;

$OFFLISTING
$SET VALIDATE 'NO'
$SET REDUCE   'YES'

$ SET DSCAUTO YES
$ SET VDA YES
$ SET DEBUG 'NO'
$ SET DUMPSOL 'NO'
$ SET SOLVE_NOW 'YES'
$ SET MODEL_NAME 'TIMES'
$ IF DECLARED REG $SET STARTRUN 'RESTART'
$ IF NOT DECLARED REG $SET STARTRUN 'SCRATCH'
$SET XTQA YES
$SET VAR_UC YES
$ SET OBJ AUTO
$ SET MID_YEAR YES
$ SET OBLONG YES
$SET DAMAGE NO
$ SET STAGES NO
$SET SOLVEDA 'YES'
$SET VARCOST LIN
$ SET DSC NO
$SET DATAGDX YES

$ONMULTI

* Time-slices must be declared before TIMES initialisation.
$BATINCLUDE ts.dd
$SET BOTIME 1902
$BATINCLUDE initsys.mod
$BATINCLUDE initmty.mod
$IF NOT DECLARED REG_BNDCST $Abort "You need to use TIMES v2.3.1 or higher"

$BATINCLUDE output.dd
$BATINCLUDE milestonyr.dd
$SET RUN_NAME '__CASE_NAME__'
$ SET VEDAVDD 'YES'

$BATINCLUDE maindrv.mod mod
